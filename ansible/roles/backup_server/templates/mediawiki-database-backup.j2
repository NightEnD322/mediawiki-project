#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

DB_HOST="${1:-{{ backup_database_host }}}"
DB_NAME="${2:-{{ backup_database_name }}}"
BACKUP_DIR="${3:-{{ backup_database_directory }}}"
RETENTION_DAYS="${4:-{{ backup_retention_days }}}"

SSH_KEY="{{ backup_ssh_key }}"
KNOWN_HOSTS="{{ backup_known_hosts }}"
TEMP_DIR=""

usage() {
    echo "Использование: sudo $0 [DB_HOST] [DB_NAME] [BACKUP_DIR] [RETENTION_DAYS]"
}

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*"
}

fail() {
    echo "ОШИБКА: $*" >&2
    exit 1
}

cleanup() {
    if [[ -n "$TEMP_DIR" && -d "$TEMP_DIR" ]]; then
        rm -rf -- "$TEMP_DIR"
    fi
}

on_error() {
    local exit_code=$?
    echo "ОШИБКА: сбой на строке $1, код завершения $exit_code" >&2
    exit "$exit_code"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

if (( $# > 4 )); then
    usage >&2
    exit 2
fi

trap cleanup EXIT
trap 'on_error "$LINENO"' ERR

[[ "$EUID" -eq 0 ]] || fail "запусти скрипт через sudo"
[[ "$DB_HOST" =~ ^[A-Za-z0-9._-]+$ ]] || fail "неверный адрес DB_HOST"
[[ "$DB_NAME" =~ ^[A-Za-z0-9_.-]+$ ]] || fail "неверное имя DB_NAME"
[[ "$BACKUP_DIR" == /* ]] || fail "BACKUP_DIR должен быть абсолютным путём"
[[ "$RETENTION_DAYS" =~ ^[0-9]+$ ]] || fail "RETENTION_DAYS должен быть целым числом"
[[ -r "$SSH_KEY" ]] || fail "не найден SSH-ключ: $SSH_KEY"
[[ -r "$KNOWN_HOSTS" ]] || fail "не найден файл known_hosts: $KNOWN_HOSTS"

mkdir -p -- "$BACKUP_DIR"

timestamp="$(date '+%Y-%m-%d_%H-%M-%S')"
dump_archive="$BACKUP_DIR/mediawiki-db-$timestamp.dump"
globals_archive="$BACKUP_DIR/mediawiki-globals-$timestamp.sql"
TEMP_DIR="$(mktemp -d "$BACKUP_DIR/.mediawiki-db.XXXXXX")"

remote_dump_command="cd /tmp && sudo -n -u postgres pg_dump --format=custom --dbname=$(printf '%q' "$DB_NAME")"
remote_globals_command="cd /tmp && sudo -n -u postgres pg_dumpall --globals-only"

ssh \
    -i "$SSH_KEY" \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o UserKnownHostsFile="$KNOWN_HOSTS" \
    -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=10 \
    "{{ backup_ssh_user }}@$DB_HOST" "$remote_dump_command" > "$TEMP_DIR/database.dump"

ssh \
    -i "$SSH_KEY" \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o UserKnownHostsFile="$KNOWN_HOSTS" \
    -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=10 \
    "{{ backup_ssh_user }}@$DB_HOST" "$remote_globals_command" > "$TEMP_DIR/globals.sql"

[[ -s "$TEMP_DIR/database.dump" ]] || fail "дамп базы пустой"
[[ -s "$TEMP_DIR/globals.sql" ]] || fail "дамп глобальных ролей пустой"
file "$TEMP_DIR/database.dump" | grep -q "PostgreSQL custom database dump"

mv -- "$TEMP_DIR/database.dump" "$dump_archive"
mv -- "$TEMP_DIR/globals.sql" "$globals_archive"
rmdir -- "$TEMP_DIR"
TEMP_DIR=""

find "$BACKUP_DIR" -type f \( \
    -name 'mediawiki-db-*.dump' -o \
    -name 'mediawiki-globals-*.sql' \
    \) -mtime "+$RETENTION_DAYS" -delete

log "Готово: $dump_archive"
log "Готово: $globals_archive"
