#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

SOURCE_HOST="${1:-{{ backup_files_source_host }}}"
SOURCE_DIR="${2:-{{ backup_files_source_directory }}}"
BACKUP_DIR="${3:-{{ backup_files_directory }}}"
RETENTION_DAYS="${4:-{{ backup_retention_days }}}"

SSH_KEY="{{ backup_ssh_key }}"
KNOWN_HOSTS="{{ backup_known_hosts }}"
TEMP_FILE=""

usage() {
    echo "Использование: sudo $0 [SOURCE_HOST] [SOURCE_DIR] [BACKUP_DIR] [RETENTION_DAYS]"
}

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*"
}

fail() {
    echo "ОШИБКА: $*" >&2
    exit 1
}

cleanup() {
    if [[ -n "$TEMP_FILE" && -f "$TEMP_FILE" ]]; then
        rm -f -- "$TEMP_FILE"
    fi
}

on_error() {
    local exit_code=$?
    echo "ОШИБКА: сбой на строке $1, код завершения $exit_code" >&2
    exit "$exit_code"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
    exit 0
fi

if (( $# > 4 )); then
    usage >&2
    exit 2
fi

trap cleanup EXIT
trap 'on_error "$LINENO"' ERR

[[ "$EUID" -eq 0 ]] || fail "запусти скрипт через sudo"
[[ "$SOURCE_HOST" =~ ^[A-Za-z0-9._-]+$ ]] || fail "неверный адрес SOURCE_HOST"
[[ "$SOURCE_DIR" == /* && "$SOURCE_DIR" != "/" ]] || fail "SOURCE_DIR должен быть абсолютным путём к каталогу"
[[ "$BACKUP_DIR" == /* ]] || fail "BACKUP_DIR должен быть абсолютным путём"
[[ "$RETENTION_DAYS" =~ ^[0-9]+$ ]] || fail "RETENTION_DAYS должен быть целым числом"
[[ -r "$SSH_KEY" ]] || fail "не найден SSH-ключ: $SSH_KEY"
[[ -r "$KNOWN_HOSTS" ]] || fail "не найден файл known_hosts: $KNOWN_HOSTS"

mkdir -p -- "$BACKUP_DIR"

timestamp="$(date '+%Y-%m-%d_%H-%M-%S')"
archive="$BACKUP_DIR/mediawiki-files-$timestamp.tar.gz"
TEMP_FILE="$(mktemp "$BACKUP_DIR/.mediawiki-files.XXXXXX")"

source_parent="$(dirname -- "$SOURCE_DIR")"
source_name="$(basename -- "$SOURCE_DIR")"
remote_parent="$(printf '%q' "$source_parent")"
remote_name="$(printf '%q' "$source_name")"
remote_command="sudo -n tar --numeric-owner -C $remote_parent -czf - -- $remote_name"

log "Создаю архив $SOURCE_DIR с сервера $SOURCE_HOST"

ssh \
    -i "$SSH_KEY" \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o UserKnownHostsFile="$KNOWN_HOSTS" \
    -o StrictHostKeyChecking=yes \
    -o ConnectTimeout=10 \
    "{{ backup_ssh_user }}@$SOURCE_HOST" "$remote_command" > "$TEMP_FILE"

[[ -s "$TEMP_FILE" ]] || fail "архив получился пустым"
gzip -t "$TEMP_FILE"

mv -- "$TEMP_FILE" "$archive"
TEMP_FILE=""

find "$BACKUP_DIR" -type f -name 'mediawiki-files-*.tar.gz' \
    -mtime "+$RETENTION_DAYS" -delete

log "Готово: $archive"
